# MailPilot Environment Configuration (Example)
# DO NOT ADD REAL SECRETS TO THIS FILE.
# Copy this file to .env and replace the values for local development.

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
# 1. Ensure your current IP is whitelisted in MongoDB Atlas Network Access.
# 2. Retrieve your connection string from the Atlas dashboard.
# 3. Replace 'user', 'password', and 'cluster.mongodb.net/mailpilot' with your actual credentials and cluster details.
# 4. WARNING: Never commit the actual .env file.
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/mailpilot?retryWrites=true&w=majority"

# Authentication
JWT_SECRET="replace-this-with-a-secure-random-string-in-development"
ADMIN_INIT_TOKEN="development-init-token-change-in-prod"

# SMTP Configuration (Development using Mailpit)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="mailpilot@localhost"

# --- Frontend Configuration ---
FRONTEND_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
